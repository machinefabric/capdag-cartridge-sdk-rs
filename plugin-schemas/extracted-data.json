{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractedData",
  "description": "Combined output containing multiple types of extracted data",
  "type": "object",
  "properties": {
    "metadata": {
      "anyOf": [
        {
          "$ref": "file-metadata.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Document metadata"
    },
    "outline": {
      "anyOf": [
        {
          "$ref": "document-outline.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Document outline/TOC"
    },
    "pages": {
      "anyOf": [
        {
          "$ref": "document-pages.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Document pages with text content"
    },
    "text_content": {
      "type": ["string", "null"],
      "description": "Extracted text content (alternative to pages structure)"
    },
    "thumbnail": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThumbnailInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Thumbnail information"
    },
    "extraction_summary": {
      "$ref": "#/definitions/ExtractionSummary",
      "description": "Extraction summary"
    }
  },
  "required": [
    "extraction_summary"
  ],
  "definitions": {
    "ThumbnailInfo": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["png", "jpg", "jpeg", "gif", "webp"],
          "description": "Image format"
        },
        "dimensions": {
          "type": ["array", "null"],
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Image dimensions [width, height] if known"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size of the image data"
        },
        "filename": {
          "type": "string",
          "description": "Suggested filename"
        }
      },
      "required": [
        "format",
        "size_bytes",
        "filename"
      ]
    },
    "ExtractionSummary": {
      "type": "object",
      "properties": {
        "source_file": {
          "type": "string",
          "description": "Source file path"
        },
        "handler_name": {
          "type": "string",
          "description": "Handler that performed the extraction"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time",
          "description": "Extraction timestamp"
        },
        "extracted_components": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "metadata",
              "outline",
              "pages",
              "text_content",
              "thumbnail"
            ]
          },
          "description": "What was successfully extracted"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Any errors or warnings"
        },
        "processing_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total processing time in milliseconds"
        }
      },
      "required": [
        "source_file",
        "handler_name",
        "extracted_at",
        "extracted_components",
        "warnings",
        "processing_time_ms"
      ]
    }
  }
}