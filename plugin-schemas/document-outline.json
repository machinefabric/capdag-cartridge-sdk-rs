{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentOutline",
  "description": "Complete document outline structure",
  "type": "object",
  "properties": {
    "source_file": {
      "type": "string",
      "description": "Source file path"
    },
    "document_title": {
      "type": ["string", "null"],
      "description": "Document title from metadata if available"
    },
    "document_type": {
      "type": "string",
      "description": "Document format/type (PDF, EPUB, etc.)"
    },
    "total_pages": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of pages/sections in document"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TocEntry"
      },
      "description": "Root-level TOC entries"
    },
    "has_outline": {
      "type": "boolean",
      "description": "Whether this document has any outline/bookmarks"
    },
    "extraction_info": {
      "$ref": "#/definitions/ExtractionInfo",
      "description": "Metadata about the extraction process"
    }
  },
  "required": [
    "source_file",
    "document_type",
    "total_pages",
    "entries",
    "has_outline",
    "extraction_info"
  ],
  "definitions": {
    "TocEntry": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title/label of this TOC entry"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "description": "Hierarchical level (0 = top level, 1 = first sublevel, etc.)"
        },
        "page": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Page/section number this entry points to (1-indexed, null if no destination)"
        },
        "source_ref": {
          "type": ["string", "null"],
          "description": "Optional source reference (filename, anchor, etc.)"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TocEntry"
          },
          "description": "Child entries under this one"
        }
      },
      "required": [
        "title",
        "level",
        "children"
      ]
    },
    "ExtractionInfo": {
      "type": "object",
      "properties": {
        "extractor_name": {
          "type": "string",
          "description": "Tool that performed the extraction"
        },
        "extractor_version": {
          "type": "string",
          "description": "Version of the extraction tool"
        },
        "extracted_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp of extraction"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Any warnings or notes about the extraction"
        }
      },
      "required": [
        "extractor_name",
        "extractor_version",
        "warnings"
      ]
    }
  }
}