{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginInfo",
  "description": "Plugin information and capabilities",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plugin name"
    },
    "version": {
      "type": "string",
      "description": "Plugin version"
    },
    "description": {
      "type": "string",
      "description": "Plugin description"
    },
    "priority": {
      "type": "string",
      "enum": [
        "optional",
        "recommended",
        "critical"
      ],
      "description": "Plugin priority level"
    },
    "capabilities": {
      "$ref": "#/definitions/PluginCapabilities",
      "description": "Plugin capabilities with file type specificity"
    },
    "author": {
      "type": ["string", "null"],
      "description": "Plugin author/maintainer"
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "priority",
    "capabilities"
  ],
  "definitions": {
    "PluginCapabilities": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+(?::[a-z*]+)?$",
            "description": "Capability with optional file type specifier (e.g., 'extract_metadata:pdf', 'generate_thumbnail:*')"
          },
          "description": "List of capabilities with optional file type specificity. Format: 'operation:filetype' or 'operation:*' for all file types. More specific capabilities take precedence."
        }
      },
      "required": [
        "capabilities"
      ]
    }
  }
}