{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginInfo",
  "description": "Plugin information and capabilities",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plugin name"
    },
    "version": {
      "type": "string",
      "description": "Plugin version"
    },
    "description": {
      "type": "string",
      "description": "Plugin description"
    },
    "plugin_type": {
      "type": "string",
      "enum": [
        "document_handler",
        "model_service",
        "embedding_service", 
        "system_service"
      ],
      "description": "Type of plugin functionality"
    },
    "priority": {
      "type": "string",
      "enum": [
        "optional",
        "recommended",
        "critical"
      ],
      "description": "Plugin priority level"
    },
    "system_critical": {
      "type": "boolean",
      "description": "Whether this plugin is critical to system operation (legacy compatibility)"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supported file extensions (for document handlers)"
    },
    "service_endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available service endpoints (for service plugins)"
    },
    "capabilities": {
      "$ref": "#/definitions/PluginCapabilities",
      "description": "Plugin capabilities"
    },
    "author": {
      "type": ["string", "null"],
      "description": "Plugin author/maintainer"
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "plugin_type",
    "priority",
    "capabilities"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "plugin_type": {
            "const": "document_handler"
          }
        }
      },
      "then": {
        "required": ["extensions"],
        "properties": {
          "extensions": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plugin_type": {
            "enum": ["model_service", "embedding_service", "system_service"]
          }
        }
      },
      "then": {
        "properties": {
          "service_endpoints": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "PluginCapabilities": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "extract_metadata",
              "extract_outline",
              "extract_pages",
              "extract_text",
              "validate_file",
              "generate_thumbnail",
              "supports_json_output",
              "model_management",
              "download_models",
              "load_models",
              "unload_models",
              "list_models",
              "model_status",
              "embedding_generation",
              "text_embeddings",
              "file_embeddings",
              "embedding_dimensions",
              "similarity_computation",
              "system_service",
              "critical_service"
            ]
          },
          "description": "List of capability names"
        }
      },
      "required": [
        "capabilities"
      ]
    }
  }
}