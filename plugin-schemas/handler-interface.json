{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified Plugin Interface",
  "description": "Unified capability-based plugin interface with standardized command-line calling",
  "type": "object",
  "properties": {
    "interface_version": {
      "type": "string",
      "const": "2.0",
      "description": "Version of the unified plugin interface"
    },
    "calling_convention": {
      "type": "object",
      "properties": {
        "unified_capability_calling": {
          "type": "object",
          "properties": {
            "description": "All plugin operations are accessed via unified capability-based calling",
            "method": "registry.can(capability).call(args)",
            "capability_format": "operation:filetype (e.g., 'extract-metadata:pdf', 'generate-thumbnail:*')",
            "args_format": "Vec<JsonValue> - type-safe JSON arguments",
            "response_format": "ResponseWrapper with type-safe deserialization",
            "error_handling": "Result<ResponseWrapper, Error> with descriptive error messages"
          }
        },
        "command_line_interface": {
          "type": "object",
          "properties": {
            "description": "Direct capability-to-CLI-flag mapping",
            "flag_format": "--{operation} (e.g., --extract-metadata, --generate-thumbnail)",
            "capability_advertising": "--plugin-info flag returns JSON with capabilities array",
            "execution_pattern": "plugin_binary --{operation} file_path [additional_args] [--json]"
          }
        }
      }
    },
    "standardized_capabilities": {
      "type": "object",
      "properties": {
        "extract-metadata": {
          "type": "object",
          "properties": {
            "description": "Extract document metadata",
            "cli_flag": "--extract-metadata",
            "args_format": ["file_path:string"],
            "response_type": {
              "$ref": "file-metadata.json"
            },
            "file_type_specificity": "Can be file-type specific (e.g., extract-metadata:pdf)"
          }
        },
        "extract-outline": {
          "type": "object",
          "properties": {
            "description": "Extract document outline/table of contents",
            "cli_flag": "--extract-outline",
            "args_format": ["file_path:string"],
            "response_type": {
              "$ref": "document-outline.json"
            },
            "file_type_specificity": "Can be file-type specific (e.g., extract-outline:epub)"
          }
        },
        "extract-pages": {
          "type": "object",
          "properties": {
            "description": "Extract document pages with text content",
            "cli_flag": "--extract-pages",
            "args_format": ["file_path:string"],
            "response_type": {
              "$ref": "document-pages.json"
            },
            "file_type_specificity": "Can be file-type specific (e.g., extract-pages:pdf)"
          }
        },
        "generate-thumbnail": {
          "type": "object",
          "properties": {
            "description": "Generate thumbnail image for the document",
            "cli_flag": "--generate-thumbnail",
            "args_format": ["file_path:string", "width:number", "height:number"],
            "response_type": "byte array - PNG image data",
            "file_type_specificity": "Can be file-type specific (e.g., generate-thumbnail:pdf)"
          }
        },
        "validate-file": {
          "type": "object",
          "properties": {
            "description": "Validate file integrity and processability",
            "cli_flag": "--validate-file",
            "args_format": ["file_path:string"],
            "response_type": "boolean",
            "file_type_specificity": "Can be file-type specific (e.g., validate-file:epub)"
          }
        }
      }
    },
    "response_wrapper": {
      "type": "object",
      "properties": {
        "description": "Unified response wrapper for type-safe deserialization",
        "methods": {
          "type": "object",
          "properties": {
            "as_type<T>()": "Deserialize to specific type with serde",
            "as_string()": "Convert response to string",
            "as_bytes()": "Get raw byte array",
            "as_int()": "Convert to integer",
            "as_bool()": "Convert to boolean"
          }
        },
        "error_handling": "Result<T, Error> with descriptive parse/conversion errors"
      }
    },
    "plugin_requirements": {
      "type": "object",
      "properties": {
        "plugin_info_flag": {
          "type": "object",
          "properties": {
            "description": "Must implement --plugin-info flag",
            "returns": {
              "$ref": "plugin-info.json"
            },
            "format": "JSON output with capabilities array using hyphenated format"
          }
        },
        "capability_flags": {
          "type": "object",
          "properties": {
            "description": "Must implement CLI flags for each advertised capability",
            "naming_convention": "--{operation} (hyphens, not underscores)",
            "json_output": "Support --json flag for structured output when applicable"
          }
        },
        "unified_calling": {
          "type": "object",
          "properties": {
            "description": "No special method handling - all operations via capability-based calling",
            "registry_integration": "Must be callable via PluginRegistry.can().call() interface",
            "type_safety": "All arguments passed as Vec<JsonValue>, responses via ResponseWrapper"
          }
        }
      }
    }
  },
  "required": [
    "interface_version",
    "calling_convention",
    "standardized_capabilities",
    "response_wrapper",
    "plugin_requirements"
  ]
}