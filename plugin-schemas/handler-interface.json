{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentHandler Interface",
  "description": "Core interface that all document file handlers must implement",
  "type": "object",
  "properties": {
    "interface_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the DocumentHandler interface"
    },
    "required_methods": {
      "type": "object",
      "properties": {
        "name": {
          "type": "object",
          "properties": {
            "description": "Get the name of this handler",
            "returns": "string",
            "async": false
          }
        },
        "version": {
          "type": "object",
          "properties": {
            "description": "Get the version of this handler",
            "returns": "string",
            "async": false
          }
        },
        "supported_extensions": {
          "type": "object",
          "properties": {
            "description": "Get the file extensions this handler supports (e.g., ['pdf'])",
            "returns": "array of strings",
            "async": false
          }
        },
        "extract_metadata": {
          "type": "object",
          "properties": {
            "description": "Extract document metadata",
            "parameters": {
              "file_path": "string - path to the file"
            },
            "returns": {
              "$ref": "file-metadata.json"
            },
            "async": true
          }
        },
        "extract_outline": {
          "type": "object",
          "properties": {
            "description": "Extract document outline/table of contents",
            "parameters": {
              "file_path": "string - path to the file"
            },
            "returns": {
              "$ref": "document-outline.json"
            },
            "async": true
          }
        },
        "extract_pages": {
          "type": "object",
          "properties": {
            "description": "Extract document pages with text content organized by pages and paragraphs",
            "parameters": {
              "file_path": "string - path to the file"
            },
            "returns": {
              "$ref": "document-pages.json"
            },
            "async": true
          }
        },
        "validate_file": {
          "type": "object",
          "properties": {
            "description": "Validate that the file is not corrupted and can be processed",
            "parameters": {
              "file_path": "string - path to the file"
            },
            "returns": "boolean",
            "async": true
          }
        },
        "get_file_info": {
          "type": "object",
          "properties": {
            "description": "Get basic file information without full processing",
            "parameters": {
              "file_path": "string - path to the file"
            },
            "returns": {
              "$ref": "#/definitions/FileInfo"
            },
            "async": true
          }
        },
        "generate_thumbnail": {
          "type": "object",
          "properties": {
            "description": "Generate thumbnail image for the document",
            "parameters": {
              "file_path": "string - path to the file",
              "width": "integer - thumbnail width in pixels",
              "height": "integer - thumbnail height in pixels"
            },
            "returns": "byte array - PNG image data",
            "async": true
          }
        }
      }
    },
    "optional_methods": {
      "type": "object",
      "properties": {
        "can_handle": {
          "type": "object",
          "properties": {
            "description": "Check if this handler can process the given file (based on file extension)",
            "parameters": {
              "file_path": "string - path to the file"
            },
            "returns": "boolean",
            "async": false,
            "default_implementation": "Checks file extension against supported_extensions()"
          }
        },
        "get_capabilities": {
          "type": "object",
          "properties": {
            "description": "Get handler capabilities",
            "returns": {
              "$ref": "plugin-info.json#/definitions/PluginCapabilities"
            },
            "async": false,
            "default_capabilities": [
              "extract_metadata",
              "extract_outline", 
              "extract_pages",
              "validate_file",
              "supports_json_output"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "FileInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File path"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "document_type": {
          "type": "string",
          "description": "Document type detected"
        },
        "is_valid": {
          "type": "boolean",
          "description": "Whether the file appears to be valid"
        },
        "quick_metadata": {
          "anyOf": [
            {
              "$ref": "#/definitions/QuickMetadata"
            },
            {
              "type": "null"
            }
          ],
          "description": "Quick metadata if easily accessible"
        }
      },
      "required": [
        "path",
        "size",
        "document_type",
        "is_valid"
      ]
    },
    "QuickMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": ["string", "null"],
          "description": "Document title"
        },
        "author": {
          "type": ["string", "null"],
          "description": "Primary author"
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Page/section count"
        }
      }
    }
  }
}