{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Interface Schema",
  "description": "Formal definition of a complete plugin interface with multiple capabilities and validation rules",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string", 
      "const": "1.0",
      "description": "Version of the plugin interface schema format"
    },
    "interface": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "description": "Plugin interface name (e.g., 'document-processor', 'pdf-handler')"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this plugin interface"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Semantic version of this interface definition"
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "min_sdk_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
              "description": "Minimum SDK version required for this interface"
            },
            "max_sdk_version": {
              "type": ["string", "null"],
              "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
              "description": "Maximum SDK version supported (null for no limit)"
            }
          },
          "required": ["min_sdk_version"]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of interface authors/maintainers"
        }
      },
      "required": ["name", "description", "version", "compatibility"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "capability-schema.json"
          },
          {
            "type": "object",
            "properties": {
              "capability_ref": {
                "type": "string",
                "description": "Reference to external capability schema file"
              }
            },
            "required": ["capability_ref"]
          }
        ]
      },
      "minItems": 1,
      "description": "List of capabilities this interface defines (inline or by reference)"
    },
    "global_requirements": {
      "type": "object",
      "properties": {
        "plugin_info_command": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean",
              "default": true
            },
            "format": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            },
            "schema_ref": {
              "type": "string",
              "default": "plugin-info.json"
            }
          }
        },
        "json_output_support": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean",
              "default": true,
              "description": "Whether plugins must support --json flag for structured output"
            },
            "flag": {
              "type": "string",
              "default": "--json",
              "description": "CLI flag for JSON output"
            }
          }
        },
        "error_handling": {
          "type": "object",
          "properties": {
            "standard_exit_codes": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "integer",
                  "default": 0
                },
                "general_error": {
                  "type": "integer", 
                  "default": 1
                },
                "invalid_arguments": {
                  "type": "integer",
                  "default": 2
                },
                "file_not_found": {
                  "type": "integer",
                  "default": 3
                },
                "unsupported_file_type": {
                  "type": "integer",
                  "default": 4
                },
                "timeout": {
                  "type": "integer",
                  "default": 5
                }
              }
            },
            "error_output_format": {
              "type": "string",
              "enum": ["stderr", "json"],
              "default": "stderr",
              "description": "Where to send error messages"
            }
          }
        }
      }
    },
    "validation_rules": {
      "type": "object",
      "properties": {
        "capability_uniqueness": {
          "type": "object",
          "properties": {
            "enforce": {
              "type": "boolean",
              "default": true,
              "description": "Whether capability names must be unique within the interface"
            },
            "scope": {
              "type": "string",
              "enum": ["interface", "global"],
              "default": "interface",
              "description": "Scope for uniqueness checking"
            }
          }
        },
        "file_type_consistency": {
          "type": "object",
          "properties": {
            "enforce": {
              "type": "boolean",
              "default": true,
              "description": "Whether file type support must be consistent across related capabilities"
            },
            "related_capabilities": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              "description": "Groups of capabilities that should have consistent file type support"
            }
          }
        },
        "version_compatibility": {
          "type": "object",
          "properties": {
            "enforce": {
              "type": "boolean",
              "default": true,
              "description": "Whether to enforce semantic versioning compatibility"
            },
            "breaking_change_detection": {
              "type": "boolean",
              "default": true,
              "description": "Whether to detect breaking changes in capability definitions"
            }
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "properties": {
        "test_files": {
          "type": "object",
          "patternProperties": {
            "^[a-z]+$": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "expected_capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["name", "path", "expected_capabilities"]
              }
            }
          },
          "description": "Test files organized by file type for validating plugin implementations"
        },
        "test_scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              },
              "expected_result": {
                "type": "object",
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "exit_code": {
                    "type": "integer"
                  },
                  "output_validation": {
                    "type": "object"
                  }
                }
              }
            },
            "required": ["name", "capability", "expected_result"]
          },
          "description": "Predefined test scenarios for validating plugin behavior"
        }
      }
    }
  },
  "required": ["schema_version", "interface", "capabilities"],
  "additionalProperties": false
}