[package]
name = "machfab-cartridge-sdk"
version = "{{ project.version }}"
edition = "2021"
authors = ["https://github.com/machinefabric"]
description = "Cartridge SDK for MachFab document processing tools"
license = "MIT"

[dependencies]
capdag = { path = "../capdag" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

[features]
default = []
